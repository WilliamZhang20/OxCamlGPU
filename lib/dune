; One library over a directory per compilation stage. The folders are listed
; here in dependency order, which is also the order the stages run in; see
; docs/architecture.md. The dependency graph across them is acyclic.
;
;   base/       target-independent types, modes, layouts, source spans
;   ir/         semantic GPU SSA and its alias analysis
;   frontend/   OxCaml .gpu metadata transported and lowered into IR
;   verify/     semantic verification, uniformity, launch contracts
;   transform/  IR-to-IR passes
;   backend/    PTX target IR, lowering, register mapping, printer
;   compiler    the driver that runs the stages, at the root as the front door
;
; dsl/gpu_dsl is the author-facing API. It is OxCaml source with mode syntax
; that host OCaml cannot parse, so it is deliberately absent from (modules)
; and is compiled only by tools/compile_oxcaml_kernels.sh.

(include_subdirs unqualified)

(library
 (name oxgpu)
 (modules
  ; base/
  gpu_type gpu_mode execution source_span verification_error layout
  ; ir/
  ir alias_analysis
  ; frontend/
  kernel_ast gpu_metadata oxcaml_frontend kernel_frontend
  ; verify/
  verifier uniformity call_verifier launch_contract
  ; transform/
  optimizer store_vector
  ; backend/
  ptx_ir ptx_lowering physical_ir ptx
  ; driver
  compiler)
 (wrapped false))
